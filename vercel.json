{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && curl -fsSL https://github.com/gleam-lang/gleam/releases/download/v1.18.1/gleam-v1.18.1-x86_64-unknown-linux-musl.tar.gz | tar -xz -C /tmp",
  "buildCommand": "PATH=/tmp:$PATH npm run build:vercel",
  "outputDirectory": "dist"
}
