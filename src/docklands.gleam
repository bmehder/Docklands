//// This module is the entry point for the Gleam portion of the site build.
////
//// Its job is orchestration rather than rendering. It decides the order in
//// which source content is loaded and handed to `generator`, then performs
//// the small amount of filesystem work that belongs to the overall build.
//// The detailed rules for routes, collection items, tags, the sitemap, and
//// robots file live in `generator.gleam`.
////
//// `npm run build` runs this program first. Later npm stages enhance the files
//// in `dist/` with syntax highlighting, optimized images, the Lustre widget,
//// and compiled Tailwind CSS. This module therefore produces the complete
//// static HTML structure, but it is not the entire npm build pipeline.

import config
import generator
import gleam/int
import gleam/io
import gleam/list
import gleam/string
import simplifile

pub fn main() -> Nil {
  // Begin from an empty output directory so deleted or renamed source files do
  // not leave stale pages behind in `dist/`.
  prepare_output()

  // Collection configuration only describes where collections live. Loading
  // turns that configuration into parsed items with frontmatter and Markdown.
  // We do this once because the same items are needed by collection pages,
  // route shortcodes, tag archives, the sitemap, and the build summary.
  let loaded_collections =
    config.collections()
    |> generator.load_collections

  // A collection contributes a shortcode such as `{{ note-list }}`. Routes
  // can embed those shortcodes even though routes and collection items are
  // stored in different source directories.
  let shortcodes = generator.collection_shortcodes(loaded_collections)

  // Routes are the standalone Markdown pages under `content/routes`. We keep
  // their source paths for both page generation and sitemap metadata.
  let route_sources = generator.load_routes()

  // Generate every HTML page. Routes receive collection data because their
  // shortcodes may render collection lists and their indexability may depend
  // on collection configuration.
  generator.build_routes(route_sources, shortcodes, loaded_collections)
  generator.build_collections(loaded_collections, shortcodes)
  generator.build_tags(loaded_collections)

  // Generate the sitemap and robots file after all routes and collection items
  // are known.
  generator.write_sitemap_and_robots(route_sources, loaded_collections)

  // Copy assets that need no processing. Raster sources beneath the images
  // directory are left for the later Sharp-based postprocess phase.
  copy_passthrough_assets()

  // Report counts from the already loaded build data; no content is read twice.
  print_build_summary(route_sources, loaded_collections)
}

/// Recreates the build destination in a known empty state.
///
/// `create_directory_all` makes the first build work when `dist/` does not yet
/// exist. `clear_directory` then makes repeated builds deterministic by removing
/// files that may have been generated by an earlier version of the content.
fn prepare_output() -> Nil {
  let assert Ok(Nil) = simplifile.create_directory_all("dist")
  let assert Ok(Nil) = simplifile.clear_directory(at: "dist")
  Nil
}

/// Copies assets that can be deployed without another build transformation.
///
/// Raster files in `assets/static/images` are source material rather than
/// deployable assets. The npm postprocess phase converts them to WebP, while
/// SVGs and other already web-ready files continue through this copy unchanged.
fn copy_passthrough_assets() -> Nil {
  let assert Ok(source_paths) = simplifile.get_files(in: "assets/static")

  source_paths
  |> list.filter(fn(source_path) { !is_raster_image_source(source_path) })
  |> list.each(fn(source_path) {
    let relative_path =
      string.drop_start(source_path, string.length("assets/static/"))
    let destination_path = "dist/assets/" <> relative_path
    let destination_directory = parent_directory(destination_path)

    let assert Ok(Nil) = simplifile.create_directory_all(destination_directory)
    let assert Ok(Nil) =
      simplifile.copy_file(at: source_path, to: destination_path)
  })

  Nil
}

fn is_raster_image_source(path: String) -> Bool {
  let raster_extensions = [
    ".avif",
    ".jpeg",
    ".jpg",
    ".png",
    ".tif",
    ".tiff",
    ".webp",
  ]
  let lowercase_path = string.lowercase(path)

  string.starts_with(path, "assets/static/images/")
  && list.any(raster_extensions, string.ends_with(lowercase_path, _))
}

fn parent_directory(path: String) -> String {
  let parts = string.split(path, on: "/")

  parts
  |> list.take(list.length(parts) - 1)
  |> string.join("/")
}

/// Prints one compact confirmation after every generation phase has succeeded.
///
/// The `let assert` expressions above make filesystem failures stop the build,
/// so reaching this function means the Gleam generation phase completed.
fn print_build_summary(
  route_sources: List(String),
  loaded_collections: List(generator.LoadedCollection),
) -> Nil {
  io.println(
    "Generated "
    <> route_sources |> list.length |> int.to_string
    <> " routes, "
    <> loaded_collections |> generator.item_count |> int.to_string
    <> " collection items, "
    <> loaded_collections |> generator.tag_count |> int.to_string
    <> " tag archives, a tag index, and passthrough assets in dist/",
  )
}
